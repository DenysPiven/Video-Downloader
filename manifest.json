{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "2.1.0",
  "description": "Finds videos on a page (MP4, WebM, HLS) and saves them to a folder you choose. Includes a Boosty mode.",
  "permissions": [
    "tabs",
    "downloads",
    "webRequest",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
