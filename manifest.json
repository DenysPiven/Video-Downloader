{
  "manifest_version": 3,
  "name": "Video Saver",
  "version": "2.0.0",
  "description": "Знаходить відео на сторінці (MP4, WebM, HLS) і скачує їх. Має окремий режим для Boosty.",
  "permissions": ["tabs", "downloads", "webRequest", "scripting", "storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Saver"
  }
}
