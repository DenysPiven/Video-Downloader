{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "2.0.0",
  "description": "Finds videos on a page (MP4, WebM, HLS) and downloads them. Includes a Boosty mode.",
  "permissions": ["tabs", "downloads", "webRequest", "scripting", "storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Downloader"
  }
}
